+ * point (the middle when no feeling is in it and nothing plays); the song playing stays while the nearest one lies in its area, so the music
+ * changes when the scene moves to another area, not at every line. Null without songs. */
+export function chooseSong(o: { points: Point[]; areas: number[]; sets: string[]; target: { at: Point; who: string } | null; place?: string | null; current: number | null }): number | null {
+    const all = o.points.map((_, i) => i), set = (s: string) => s.trim().toLowerCase(), place = set(o.place ?? '');
+    const byWho = o.target ? all.filter(i => set(o.sets[i] ?? '') && set(o.sets[i]!) === set(o.target!.who)) : [];
+    const named = byWho.length ? byWho : place ? all.filter(i => set(o.sets[i] ?? '') && place.includes(set(o.sets[i]!))) : [];
+    const free = all.filter(i => !set(o.sets[i] ?? ''));
+    const pool = named.length ? named : free.length ? free : all;
+    if (!pool.length) return null;
+    // No feeling in the scene: what plays goes on.
+    if (!o.target && o.current != null && pool.includes(o.current)) return o.current;
+    const at = o.target?.at ?? { v: 0, a: 0 };
+    const near = pool.reduce((m, i) => Math.hypot(o.points[i]!.v - at.v, o.points[i]!.a - at.a) < Math.hypot(o.points[m]!.v - at.v, o.points[m]!.a - at.a) ? i : m);
+    return o.current != null && pool.includes(o.current) && o.areas[o.current] === o.areas[near] ? o.current : near;
+}
