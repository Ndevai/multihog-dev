+        case 'BodyStrike': return `${s(a.attack) || 'blow'} → ${s(a.who)}${a.part ? ` · ${s(a.part)}` : ''}`;
+        case 'Act': return `${cut(s(a.action), 48)}${m('distance_m')}`;
+        case 'Chase': return a.pursuer === player ? `after ${s(a.fleeing)}${m('gap_m')}` : `away from ${s(a.pursuer)}${m('gap_m')}`;
