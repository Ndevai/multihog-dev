+.rules-v-add-ha { font-size: 0.6em; vertical-align: super; color: color-mix(in srgb, #E69F00 50%, var(--SmartThemeBodyColor)); }
+.rules-v-add-micro, .rules-v-add-pause { letter-spacing: 0.1em; }
+[title].rules-v { cursor: help; }
