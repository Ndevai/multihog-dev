+const inSpan = ([a, b]: Span, y: number | null) => y == null || ((a == null || y >= a) && (b == null || y <= b));
+const labelSpan = (v: string, how: 'both' | 'start'): Span => {
+    const m = v.match(/(\d{3,4})–(\d{3,4})/);
