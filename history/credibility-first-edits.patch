+/* Rules Engine: the reading note under the player's line and the question popup (src/ui.ts), in the user's theme
+   (SillyTavern's theme variables, public/style.css :root) and in a book serif that follows the story's era. Nothing moves.
+
+   Period type, by the story's year (src/ui.ts eraOf); each face is subset to Latin, OFL-licensed (fonts/OFL-*.txt):
+   before 1600  EB Garamond: Garamont's roman and Granjon's italic, from the Berner specimen of 1592
+   1600-1749    IM FELL English: the Fell types of the Oxford press, 1670s-1680s
+   1750-1799    Libre Baskerville: Baskerville's design (1757), from the ATF revival of 1941
+   1800-1919    Old Standard: the Modern (Didone) style of late nineteenth- and early twentieth-century editions
+   1920-1969    Libre Caslon Text: Caslon as mid-twentieth-century lettering drew it
+   1970 on, or no calendar date: Georgia and the system's book serifs. */
+@font-face { font-family: 'Rules EB Garamond'; src: url('fonts/garamond.woff') format('woff'); font-style: normal; font-weight: 400; font-display: swap; }
+@font-face { font-family: 'Rules EB Garamond'; src: url('fonts/garamond-italic.woff') format('woff'); font-style: italic; font-weight: 400; font-display: swap; }
+@font-face { font-family: 'Rules IM Fell English'; src: url('fonts/fell.woff') format('woff'); font-style: normal; font-weight: 400; font-display: swap; }
+@font-face { font-family: 'Rules IM Fell English'; src: url('fonts/fell-italic.woff') format('woff'); font-style: italic; font-weight: 400; font-display: swap; }
+@font-face { font-family: 'Rules Baskerville Subset'; src: url('fonts/baskerville.woff') format('woff'); font-style: normal; font-weight: 400; font-display: swap; }
+@font-face { font-family: 'Rules Baskerville Subset'; src: url('fonts/baskerville-italic.woff') format('woff'); font-style: italic; font-weight: 400; font-display: swap; }
+@font-face { font-family: 'Rules Old Standard'; src: url('fonts/oldstandard.woff') format('woff'); font-style: normal; font-weight: 400; font-display: swap; }
+@font-face { font-family: 'Rules Old Standard'; src: url('fonts/oldstandard-italic.woff') format('woff'); font-style: italic; font-weight: 400; font-display: swap; }
+@font-face { font-family: 'Rules Libre Caslon Text'; src: url('fonts/caslon.woff') format('woff'); font-style: normal; font-weight: 400; font-display: swap; }
+@font-face { font-family: 'Rules Libre Caslon Text'; src: url('fonts/caslon-italic.woff') format('woff'); font-style: italic; font-weight: 400; font-display: swap; }
+
+.rules-era-c16 { --rules-serif: 'Rules EB Garamond', Garamond, 'Palatino Linotype', Palatino, serif; --rules-nums: oldstyle-nums proportional-nums; }
+.rules-era-c17 { --rules-serif: 'Rules IM Fell English', 'Rules EB Garamond', serif; --rules-nums: normal; }
+.rules-era-c18 { --rules-serif: 'Rules Baskerville Subset', Baskerville, 'Baskerville Old Face', serif; --rules-nums: normal; }
+.rules-era-c19 { --rules-serif: 'Rules Old Standard', 'Bodoni 72', Didot, serif; --rules-nums: normal; }
+/* Libre Caslon's italic joins s to p and t in its standard ligatures, which reads as a long s: off. */
+.rules-era-c20 { --rules-serif: 'Rules Libre Caslon Text', 'Big Caslon', serif; --rules-nums: oldstyle-nums; font-variant-ligatures: no-common-ligatures; }
+.rules-era-now { --rules-serif: Georgia, 'Iowan Old Style', 'Palatino Linotype', Palatino, serif; --rules-nums: normal; }
+
+/* The note: an italic aside under the line, folded to one line (the guess, then each call's tag and words), opened to a
+   line per call with its tag in a column. font-size-adjust gives every era's face the same x-height. */
+.rules-reading {
+    margin: 0.4em 0 0.1em;
+    padding: 0 0 0 0.75em;
+    border-left: 2px solid var(--SmartThemeEmColor);
+    border-radius: 0;
+    font-family: var(--rules-serif);
+    font-style: italic;
+    font-size: calc(var(--mainFontSize) * 0.9);
+    font-size-adjust: 0.46;
+    font-variant-numeric: var(--rules-nums, normal);
+    line-height: 1.45;
+    color: var(--SmartThemeEmColor);
+}
+.rules-reading-sum { display: flex; gap: 0.6em; align-items: baseline; white-space: nowrap; overflow: hidden; cursor: pointer; list-style: none; }
+.rules-reading-sum::-webkit-details-marker { display: none; }
+.rules-reading-sum::before { content: '▸'; flex: none; font-style: normal; font-size: 0.8em; }
+.rules-reading[open] > .rules-reading-sum::before { content: '▾'; }
+.rules-reading-sum:focus-visible { outline: 1px solid var(--interactable-outline-color); outline-offset: 2px; }
+.rules-reading-taken, .rules-reading-redone, .rules-reading-meant { flex: 0 0 auto; max-width: 75%; overflow: hidden; text-overflow: ellipsis; color: var(--SmartThemeQuoteColor); }
+.rules-reading-or { flex: none; margin-left: -0.3em; color: var(--SmartThemeQuoteColor); }
+.rules-reading-list { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+.rules-reading-item + .rules-reading-item::before { content: ' · '; }
+.rules-reading-label { display: none; }
+.rules-reading[open] .rules-reading-list { display: none; }
+.rules-reading[open] .rules-reading-sum:not(:has(.rules-reading-taken, .rules-reading-redone, .rules-reading-meant)) .rules-reading-label { display: inline; }
+.rules-reading-body { padding: 0.15em 0 0.25em 1.05em; }
+.rules-reading-row { display: flex; gap: 0.4em; align-items: baseline; }
+.rules-reading-row > .rules-tag { flex: none; min-width: 3.7em; }
+.rules-reading-text[title] { cursor: help; }
+.rules-reading-alts { margin: 0.3em 0 0; }
+
+/* A tag names the kind of rule in a word and a colour: Okabe & Ito's colour-blind-safe hues, each mixed with the theme's
+   text colour by the share that keeps it at 4.5:1 or more on SillyTavern's shipped themes (dark) and a light one
+   (tests/ui.test.mjs reads these shares). */
+.rules-tag { font-style: normal; font-variant: small-caps; letter-spacing: 0.03em; margin-right: 0.3em; }
+.rules-reading[data-tone="dark"] .rules-k-sense { color: color-mix(in srgb, #56B4E9 85%, var(--SmartThemeBodyColor)); }
+.rules-reading[data-tone="dark"] .rules-k-speech { color: color-mix(in srgb, #009E73 40%, var(--SmartThemeBodyColor)); }
+.rules-reading[data-tone="dark"] .rules-k-body { color: color-mix(in srgb, #D55E00 40%, var(--SmartThemeBodyColor)); }
+.rules-reading[data-tone="dark"] .rules-k-move { color: color-mix(in srgb, #E69F00 85%, var(--SmartThemeBodyColor)); }
+.rules-reading[data-tone="dark"] .rules-k-mind { color: color-mix(in srgb, #CC79A7 70%, var(--SmartThemeBodyColor)); }
+.rules-reading[data-tone="dark"] .rules-k-time { color: color-mix(in srgb, #F0E442 85%, var(--SmartThemeBodyColor)); }
+.rules-reading[data-tone="dark"] .rules-k-thing { color: color-mix(in srgb, #0072B2 25%, var(--SmartThemeBodyColor)); }
+.rules-reading[data-tone="light"] .rules-k-sense { color: color-mix(in srgb, #56B4E9 55%, var(--SmartThemeBodyColor)); }
+.rules-reading[data-tone="light"] .rules-k-speech { color: color-mix(in srgb, #009E73 70%, var(--SmartThemeBodyColor)); }
+.rules-reading[data-tone="light"] .rules-k-body { color: color-mix(in srgb, #D55E00 80%, var(--SmartThemeBodyColor)); }
