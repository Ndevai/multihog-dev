+.rules-reading[data-tone="light"] .rules-k-time { color: color-mix(in srgb, #F0E442 35%, var(--SmartThemeBodyColor)); }
+.rules-reading[data-tone="light"] .rules-k-thing { color: color-mix(in srgb, #0072B2 90%, var(--SmartThemeBodyColor)); }
+
+/* A linked word: a choice or another reading, underlined in the theme's underline colour. */
