+++ b/src/rules/voice-body.js
@@ -0,0 +1,72 @@
+// A character's own voice, computed from their body (docs/df-body-engine.md, "The voice from the body"; the player's picks,
+// 2026-11-11: store the causes, compute what they give; the full chain; bits per syllable from the 17 measured languages;
+// each person's own difference one draw from a measured spread). Few facts are kept (height, sex, age, the language spoken)
+// and one number drawn once (rateZ); the rest is derived: the vocal tract's length and its resonances (formants), the
+// vocal folds' length and the pitch they give, the syllables a second. The forward map is a function, the reverse is not:
+// many tract shapes give one formant pattern (Atal, Chang, Mathews & Tukey 1978, JASA 63:1535), so the cause is what is kept.
+import { def, peek } from './constants.js';
+import { INFO_RATE } from './data/info-rate.js';
+// --------------------------------------------------------------------------------------------------------- the tract
+/** The speed of sound in the tract's air at body temperature: c = 331.3 √(1 + T ÷ 273.15) m/s for air (ideal gas), at
+ * 37 °C 353.0 m/s. */
+export const SOUND_IN_TRACT = 331.3 * Math.sqrt(1 + 37 / 273.15);
+/** The resonances of a tract of length `cm` held in the neutral vowel (a uniform tube closed at the glottis, open at the
+ * lips): F_n = (2n − 1) c ÷ 4L, a quarter wavelength and its odd multiples (Fant 1960, Acoustic Theory of Speech
+ * Production; at 17.5 cm 504, 1513 and 2522 Hz, the schwa's 500, 1500, 2500). */
+export const formantsOf = (cm, n = 3) => Array.from({ length: n }, (_, i) => Math.round((2 * i + 1) * SOUND_IN_TRACT * 100 / (4 * cm)));
+// The tract grows with the body: its length correlates with height in MRI (Fitch & Giedd 1999, JASA 106:1511, 129 people
+// aged 2–25). Its length per cm of height, by sex, from measured voices: the tract length their formants give (the spacing
+// of adjacent formants is c ÷ 2L, formant dispersion: Fitch 1997, JASA 102:1213), averaged over vowels and speakers, over
+// the speakers' mean height. Hillenbrand et al. 1995 (JASA 97:3099; the phonTools package's h95 data): 45 men 17.79 cm,
+// 48 women 15.80 cm; US adults born 1960, measured 1994 (body-size.ts): 177.24 and 163.76 cm. Peterson & Barney 1952
+// (pb52): 18.81 and 16.06 cm over 174.56 and 160.98 cm (born 1925, 1951), the ranges' other ends.
+def({ id: 'voiceTractPerHeightMale', value: 0.1004, unit: 'cm of vocal tract per cm of height, men', status: 'fitted', src: 'Hillenbrand et al. 1995 formant dispersion 17.79 cm ÷ US men 177.24 cm; Peterson & Barney 1952: 0.1077', range: [0.1004, 0.1077], file: 'voice-body.ts' });
+def({ id: 'voiceTractPerHeightFemale', value: 0.0965, unit: 'cm of vocal tract per cm of height, women', status: 'fitted', src: 'Hillenbrand et al. 1995 formant dispersion 15.80 cm ÷ US women 163.76 cm; Peterson & Barney 1952: 0.0998', range: [0.0965, 0.0998], file: 'voice-body.ts' });
+// --------------------------------------------------------------------------------------------------------- the folds
+/** The membranous vocal folds' length from height, mm: cadaver larynges, 22 men and 17 women ("Length of the Human Vocal
+ * Folds: Proposal of Mathematical Equations as a Function of Gender and Body Height", Ann Otol Rhinol Laryngol):
+ * 0.18 h − 15.8 for men, 0.24 h − 28.1 for women, h in cm. */
+export const foldMmOf = (heightCm, male) => male ? 0.18 * heightCm - 15.8 : 0.24 * heightCm - 28.1;
+// The folds as a string: f0 = v ÷ 2L, v = √(stress ÷ density) the speed of a transverse wave along them (Titze 1994,
+// Principles of Voice Production; pitch scales mainly with membranous length, Titze 1989, JASA 85:1699). v by sex, fitted
+// so the mean speaker's folds give the measured mean pitch: men 131.2 Hz over 16.10 mm, women 220.4 Hz over 11.20 mm
+// (Hillenbrand et al. 1995 at the heights above): 4.22 and 4.94 m/s. The folds' lengths alone give 70 % of the sexes'
+// pitch difference in log terms (1.44 of 1.68); the rest is in v (tissue stress and density).
+def({ id: 'voiceFoldWaveMale', value: 4.225, unit: 'm/s, transverse wave speed along men\'s vocal folds', status: 'fitted', src: '2 × 16.10 mm × 131.2 Hz (cadaver equation at 177.24 cm; Hillenbrand et al. 1995 men\'s mean f0)', range: [4.0, 4.4], file: 'voice-body.ts' });
+def({ id: 'voiceFoldWaveFemale', value: 4.938, unit: 'm/s, transverse wave speed along women\'s vocal folds', status: 'fitted', src: '2 × 11.20 mm × 220.4 Hz (cadaver equation at 163.76 cm; Hillenbrand et al. 1995 women\'s mean f0)', range: [4.7, 5.2], file: 'voice-body.ts' });
+// --------------------------------------------------------------------------------------------------------- the rate
+// The information a speaker delivers per second, alike across languages: 39.15 bits/s (Coupé et al. 2019, 17 languages);
