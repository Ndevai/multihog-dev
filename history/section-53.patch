+
+// --------------------------------------------------------------------------------------------------------- the folds
+/** The membranous vocal folds' length from height, mm: cadaver larynges, 22 men and 17 women ("Length of the Human Vocal
+ * Folds: Proposal of Mathematical Equations as a Function of Gender and Body Height", Ann Otol Rhinol Laryngol):
+ * 0.18 h − 15.8 for men, 0.24 h − 28.1 for women, h in cm. */
+export const foldMmOf = (heightCm: number, male: boolean) => male ? 0.18 * heightCm - 15.8 : 0.24 * heightCm - 28.1;
+// The folds as a string: f0 = v ÷ 2L, v = √(stress ÷ density) the speed of a transverse wave along them (Titze 1994,
+// Principles of Voice Production; pitch scales mainly with membranous length, Titze 1989, JASA 85:1699). v by sex, fitted
+// so the mean speaker's folds give the measured mean pitch: men 131.2 Hz over 16.10 mm, women 220.4 Hz over 11.20 mm
+// (Hillenbrand et al. 1995 at the heights above): 4.22 and 4.94 m/s. The folds' lengths alone give 70 % of the sexes'
+// pitch difference in log terms (1.44 of 1.68); the rest is in v (tissue stress and density).
+def({ id: 'voiceFoldWaveMale', value: 4.225, unit: 'm/s, transverse wave speed along men\'s vocal folds', status: 'fitted', src: '2 × 16.10 mm × 131.2 Hz (cadaver equation at 177.24 cm; Hillenbrand et al. 1995 men\'s mean f0)', range: [4.0, 4.4], file: 'voice-body.ts' });
+def({ id: 'voiceFoldWaveFemale', value: 4.938, unit: 'm/s, transverse wave speed along women\'s vocal folds', status: 'fitted', src: '2 × 11.20 mm × 220.4 Hz (cadaver equation at 163.76 cm; Hillenbrand et al. 1995 women\'s mean f0)', range: [4.7, 5.2], file: 'voice-body.ts' });
+
+// --------------------------------------------------------------------------------------------------------- the rate
+// The information a speaker delivers per second, alike across languages: 39.15 bits/s (Coupé et al. 2019, 17 languages);
+// a language's syllables a second is that over its bits per syllable (data/info-rate.ts). In those data the rate so
+// predicted lies within 16 % of each language's measured one, 8.2 % on average (root mean square; English 5.52 against
+// 6.38, Thai 5.45 against 4.70).
