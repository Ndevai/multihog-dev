+}
+
+/** What the voice is computed from. */
+export interface VoiceFacts { heightCm?: number; sex?: string; age?: number; language?: string; rateZ?: number }
+/** A voice as computed: the tract and its formants and the folds and their pitch for an adult of known height and sex;
+ * syllables a second in talk for anyone. */
+export interface Voice { tractCm?: number; formantsHz?: number[]; foldMm?: number; f0Hz?: number; bits: number; bitsMeasured: boolean; sylPerS: number }
+/** The voice of a person (the facts above): the anatomy for an adult (18 or over: the samples' range) with height and sex;
+ * the rate from the language's bits per syllable, the person's sex and age, their own draw, and talk against reading. */
+export function voiceOf(f: VoiceFacts): Voice {
+    const male = /^m/i.test(f.sex ?? ''), sexKnown = /^(m|f|w)/i.test(f.sex ?? '');
+    const { bits, measured } = bitsOf(f.language);
+    const sexRate = !sexKnown ? 1 : male ? 1.0268 : 0.9732, ageRate = f.age != null ? 1 - 0.000794 * (f.age - 30.6) : 1;
+    const sylPerS = Math.round(peek('voiceInfoRate') / bits * sexRate * ageRate * (1 + peek('voiceRateSpread') * (f.rateZ ?? 0)) * TALK_OF_READING * 100) / 100;
+    const out: Voice = { bits: Math.round(bits * 100) / 100, bitsMeasured: measured, sylPerS };
+    if (f.heightCm && sexKnown && (f.age == null || f.age >= 18)) {
+        const tract = f.heightCm * peek(male ? 'voiceTractPerHeightMale' : 'voiceTractPerHeightFemale'), fold = foldMmOf(f.heightCm, male);
+        Object.assign(out, { tractCm: Math.round(tract * 10) / 10, formantsHz: formantsOf(tract), foldMm: Math.round(fold * 10) / 10,
+            f0Hz: Math.round(peek(male ? 'voiceFoldWaveMale' : 'voiceFoldWaveFemale') / (2 * fold / 1000)) });
+    }
+    return out;
+}
+/** The voice in a line for the narrator and the name plate's hover. */
+export const voiceLine = (v: Voice) => [v.tractCm ? `tract ${v.tractCm} cm, formants ${v.formantsHz!.join(' / ')} Hz, pitch about ${v.f0Hz} Hz` : '',
+    `${v.sylPerS} syllables/s in talk`].filter(Boolean).join(', ');
