+// The natural voice's worker (index.ts, speech.ts): Piper's model run by onnxruntime-web off the page's thread, so the box
+// keeps typing while a line is made. The page sends the model's bytes once ("load"), then each line's phoneme ids, speaker
+// and length scale ("speak"); the worker answers with the audio (22,050 Hz, float samples).
+type Ort = {
+    env: { wasm: { wasmPaths: string; numThreads: number } };
+    Tensor: new (type: string, data: BigInt64Array | Float32Array, dims: number[]) => unknown;
+    InferenceSession: { create(bytes: Uint8Array): Promise<{ run(feeds: Record<string, unknown>): Promise<{ output: { data: Float32Array } }> }> };
+};
+const scope = globalThis as unknown as { onmessage: (e: { data: Msg }) => void; postMessage(m: unknown, transfer?: Transferable[]): void };
+type Msg = { type: 'load'; ortUrl: string; bytes: Uint8Array } | { type: 'speak'; id: number; ids: number[]; sid: number; lengthScale: number; noiseScale: number; noiseW: number };
+let ready: Promise<{ ort: Ort; session: Awaited<ReturnType<Ort['InferenceSession']['create']>> }> | null = null;
+scope.onmessage = e => {
+    const m = e.data;
+    if (m.type === 'load') {
+        ready = (import(`${m.ortUrl}ort.wasm.min.mjs`) as Promise<Ort>).then(async ort => {
+            ort.env.wasm.wasmPaths = m.ortUrl; ort.env.wasm.numThreads = 1;
+            return { ort, session: await ort.InferenceSession.create(m.bytes) };
+        });
+        ready.then(() => scope.postMessage({ type: 'loaded' }), err => scope.postMessage({ type: 'error', error: String(err) }));
+        return;
+    }
+    if (!ready) { scope.postMessage({ type: 'audio', id: m.id, error: 'not loaded' }); return; }
+    ready.then(async ({ ort, session }) => {
+        const n = m.ids.length, r = await session.run({
+            input: new ort.Tensor('int64', BigInt64Array.from(m.ids.map(BigInt)), [1, n]),
+            input_lengths: new ort.Tensor('int64', BigInt64Array.from([BigInt(n)]), [1]),
+            scales: new ort.Tensor('float32', Float32Array.from([m.noiseScale, m.lengthScale, m.noiseW]), [3]),
+            sid: new ort.Tensor('int64', BigInt64Array.from([BigInt(m.sid)]), [1]),
+        });
+        const audio = Float32Array.from(r.output.data);
+        scope.postMessage({ type: 'audio', id: m.id, audio }, [audio.buffer]);
+    }).catch(err => scope.postMessage({ type: 'audio', id: m.id, error: String(err) }));
+};
