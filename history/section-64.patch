+"use strict";
+const scope = globalThis;
+let ready = null;
+scope.onmessage = e => {
+    const m = e.data;
+    if (m.type === 'load') {
+        ready = import(`${m.ortUrl}ort.wasm.min.mjs`).then(async (ort) => {
+            ort.env.wasm.wasmPaths = m.ortUrl;
+            ort.env.wasm.numThreads = 1;
+            return { ort, session: await ort.InferenceSession.create(m.bytes) };
+        });
+        ready.then(() => scope.postMessage({ type: 'loaded' }), err => scope.postMessage({ type: 'error', error: String(err) }));
+        return;
+    }
+    if (!ready) {
+        scope.postMessage({ type: 'audio', id: m.id, error: 'not loaded' });
+        return;
+    }
+    ready.then(async ({ ort, session }) => {
+        const n = m.ids.length, r = await session.run({
+            input: new ort.Tensor('int64', BigInt64Array.from(m.ids.map(BigInt)), [1, n]),
+            input_lengths: new ort.Tensor('int64', BigInt64Array.from([BigInt(n)]), [1]),
+            scales: new ort.Tensor('float32', Float32Array.from([m.noiseScale, m.lengthScale, m.noiseW]), [3]),
+            sid: new ort.Tensor('int64', BigInt64Array.from([BigInt(m.sid)]), [1]),
+        });
+        const audio = Float32Array.from(r.output.data);
+        scope.postMessage({ type: 'audio', id: m.id, audio }, [audio.buffer]);
+    }).catch(err => scope.postMessage({ type: 'audio', id: m.id, error: String(err) }));
+};
