+// --------------------------------------------------------------------------------------------------- the choice of voice
+// The engine's voices are on Hillenbrand et al.'s scale (isolated words: the mean man 130.9 Hz and 17.79 cm, the mean woman
+// 220.1 Hz and 15.80 cm; voice-sound.ts MEASURED); the copies speak freely, lower (EARS medians: men 107.0 Hz, women 174.1 Hz).
+// A computed voice is put on the copies' scale by the line through the two sexes' means (ln f0 and tract; derived), then the
+// nearest copy is chosen: pitch in SDs of ln f0 and tract in cm SDs, each the mean of the two sexes' SDs among the copies, and
+// age, the middle of the speaker's age band, in steps of earsAgeStep years [ASSUMED: the voice ages through breath and rough
+// phonation the body engine does not compute yet].
+def({ id: 'earsAgeStep', value: 15, unit: 'years of age that weigh as one SD of pitch or tract in the choice of recording', status: 'assumed', src: "one and a half EARS age bands (10 years each)", range: [8, 30], file: 'pocket.ts' });
+const lnLine = (x, x0, x1, y0, y1) => y0 + (x - x0) * (y1 - y0) / (x1 - x0);
+/** A computed pitch (Hz) and tract (cm) on the copies' scale. */
+export function onCopiesScale(f0Hz, tractCm) {
+    const m = MEASURED.male, w = MEASURED.female, em = EARS_MEDIANS.male, ew = EARS_MEDIANS.female;
+    return { f0: Math.exp(lnLine(Math.log(f0Hz), Math.log(m.f0Hz), Math.log(w.f0Hz), Math.log(em.f0), Math.log(ew.f0))), tract: lnLine(tractCm, m.tractCm, w.tractCm, em.tract, ew.tract) };
+}
+const sdOf = (xs) => { const m = xs.reduce((a, b) => a + b, 0) / xs.length; return Math.sqrt(xs.reduce((a, b) => a + (b - m) ** 2, 0) / (xs.length - 1)); };
