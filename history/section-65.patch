+    if (type === 1) {
+        PIECE_ID.set(p, id);
+        MAX_PIECE = Math.max(MAX_PIECE, [...p].length);
+        MIN_SCORE = Math.min(MIN_SCORE, score);
+    }
+    else if (type === 6)
+        BYTE_ID.set(parseInt(p.slice(3, 5), 16), id);
+});
