+            let named = false;
+            for (const [h, , s, e] of fields(vs, ve))
+                if (h === 1)
+                    named = want.has(new TextDecoder().decode(model.subarray(s, e)));
+            if (!named)
+                continue;
+            for (let k = vs; k + 3 < ve; k++)
+                if (model[k] === 0x03 && model[k + 1] === 0x08 && model[k + 2] === 0xe8 && model[k + 3] === 0x07) {
+                    model[k + 1] = 0x12;
+                    model[k + 2] = 0x01;
+                    model[k + 3] = 0x63;
+                    n++;
+                }
+        }
+    }
+    return n;
+}
