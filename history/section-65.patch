+    const best = new Array(n + 1).fill(-Infinity), from = new Array(n + 1).fill(-1), piece = new Array(n + 1).fill(-1);
+    best[0] = 0;
+    for (let i = 0; i < n; i++) {
+        if (best[i] === -Infinity)
+            continue;
+        let single = false;
+        for (let len = 1, s = ''; len <= MAX_PIECE && i + len <= n; len++) {
+            s += cs[i + len - 1];
+            const id = PIECE_ID.get(s);
