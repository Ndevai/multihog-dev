+    function* fields(from, to) {
+        for (let p = from; p < to;) {
+            const [key, q] = varint(p), f = Math.floor(key / 8), w = key & 7;
+            if (w === 0) {
+                p = varint(q)[1];
+                continue;
+            }
+            if (w === 1) {
+                p = q + 8;
+                continue;
+            }
+            if (w === 5) {
+                p = q + 4;
+                continue;
+            }
+            if (w !== 2)
+                throw new Error(`wire type ${w}`);
+            const [len, r] = varint(q);
+            yield [f, w, r, r + len];
+            p = r + len;
+        }
+    }
+    let n = 0;
+    for (const [f, , gs, ge] of fields(0, model.length)) {
+        if (f !== 7)
+            continue;
+        for (const [g, , vs, ve] of fields(gs, ge)) {
+            if (g !== 11 && g !== 12)
