+    for (let j = n; j > 0; j = from[j]) {
+        const id = piece[j];
+        out.push(id >= 0 ? [id] : [...new TextEncoder().encode(cs[j - 1])].map(b => BYTE_ID.get(b) ?? 0));
+    }
