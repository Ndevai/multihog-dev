+            const sc = best[i] + POCKET_PIECES[id][1];
+            if (sc > best[i + len]) {
+                best[i + len] = sc;
+                from[i + len] = i;
+                piece[i + len] = id;
+            }
+        }
+        if (!single && best[i] + unk > best[i + 1]) {
+            best[i + 1] = best[i] + unk;
+            from[i + 1] = i;
+            piece[i + 1] = -1;
+        }
+    }
