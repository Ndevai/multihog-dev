+      && near(late - b, 0.93, 0.02) && near(G.heightShare(true, 4.9999), G.heightShare(true, 5), 1e-4) && G.heightShare(true, 25) > 0.9999 && G.heightShare(false, 2) < G.heightShare(false, 4),
