+    const L = L0 + (L1 - L0) * w, M = M0 + (M1 - M0) * w, S = S0 + (S1 - S0) * w;
+    return Math.abs(L) < 1e-6 ? M * Math.exp(S * z) : M * (1 + L * S * z) ** (1 / L);
