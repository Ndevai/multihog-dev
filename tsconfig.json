{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/rules/**/*.ts"
  ]
}
